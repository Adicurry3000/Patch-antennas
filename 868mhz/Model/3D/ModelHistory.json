        {
            "caption": "farfield plot options",
            "version": "2025.0|34.0.1|20240830",
            "hidden": false,
            "type": "vba",
            "code": [
                "With FarfieldPlot ",
                "     .Plottype \"2DOrtho\" ",
                "     .Vary \"angle1\" ",
                "     .Theta \"90\" ",
                "     .Phi \"90\" ",
                "     .Step \"5\" ",
                "     .Step2 \"5\" ",
                "     .SetLockSteps \"True\" ",
                "     .SetPlotRangeOnly \"False\" ",
                "     .SetThetaStart \"0\" ",
